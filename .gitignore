# DSH 运行时产物（会话面板等本地数据，不入库）
.dsh-ops/
# 本仓库自身的项目记录：插件在这里被 dogfood，manifest 与生成的指令是这台机器的本地状态，
# 不是源码。真正使用插件的仓库要不要提交 `.dsh-project/PROJECT_INSTRUCTIONS.md` 由它自己决定。
.dsh-project/

# 依赖
node_modules/
vendor/
.pnpm-store/

# 构建产物
# 注意：lib/ 是**故意提交**的 —— 插件从 git 安装时没有构建步骤，必须能直接加载。
# 这里只忽略编译中间物与测试输出。
build/
dist/
out/
target/
*.tsbuildinfo

# 缓存与日志
.cache/
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# 环境与密钥
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.py[cod]
.venv/
venv/
