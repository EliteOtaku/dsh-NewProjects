{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"],
    // This config is the editor/typecheck view only. Emitting here would scatter `.js`
    // next to every `.ts` under src/, and those stale artifacts win Node's resolution
    // before a later `tsc -p tsconfig.build.json` refreshes them — which makes a
    // hand-edited source look like it has no effect.
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
